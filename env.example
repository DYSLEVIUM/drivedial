# Django Configuration
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok.io,.ngrok-free.app

# Ngrok (for development)
NGROK_AUTHTOKEN=your-ngrok-token

# =============================================================================
# Provider Configuration
# =============================================================================

# Voice AI Provider: openai (default), gemini
VOICE_PROVIDER=openai

# Telephony Provider: twilio (default), ozonetel
TELEPHONY_PROVIDER=twilio

# =============================================================================
# OpenAI Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini-realtime-preview-2024-12-17
OPENAI_VOICE=coral
OPENAI_TEMPERATURE=0.6
OPENAI_AGENT_NAME=Anuja
OPENAI_COMPANY_NAME=Acko Drive

# =============================================================================
# Twilio Configuration (if TELEPHONY_PROVIDER=twilio)
# =============================================================================
# No additional config needed - Twilio sends credentials via webhook

# =============================================================================
# Ozonetel Configuration (if TELEPHONY_PROVIDER=ozonetel)
# =============================================================================
OZONETEL_API_KEY=your-ozonetel-api-key
OZONETEL_SIP_NUMBER=your-sip-registration-number

# =============================================================================
# Gemini Configuration (if VOICE_PROVIDER=gemini)
# =============================================================================
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash-live-001
GEMINI_VOICE=Kore
# Available voices: Puck, Charon, Kore, Fenrir, Aoede, Leda, Orus, Zephyr

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=DEBUG
